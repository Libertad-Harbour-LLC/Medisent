# ---------------------------------------------------------------------------
# Копия этого файла с реальными значениями называется .env и в git не попадает.
# Как получить каждое значение — docs/DEPLOY.md, там по шагам с ссылками.
# ---------------------------------------------------------------------------

# --- Telegram (этап 0) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=            # единственный разрешённый пользователь, число

# --- База (этап 1) ------------------------------------------------------
# Локально подставляется из docker-compose. В Railway приходит из переменных
# managed-базы; драйвер обязательно postgresql+asyncpg://
DATABASE_URL=

# --- Gemini (этап 3) ----------------------------------------------------
GEMINI_API_KEY=
LLM_REPORT_MODEL=gemini-flash-latest    # модель для отчёта
LLM_EMAIL_MODEL=gemini-flash-latest     # модель для письма

# --- Поиск и скрейпинг (этап 4) -----------------------------------------
# Без этих двух бот стартует, только пишет предупреждение в лог.
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

# --- Gmail (этап 7) -----------------------------------------------------
# Scopes строго gmail.send + gmail.readonly. Полный mail.google.com не нужен.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=                 # с какого адреса шлём
FORWARD_TO_EMAIL=             # куда пересылать приложенные файлы

# --- Реестры Росздравнадзора (этап 2) -----------------------------------
# Базовые адреса. Владелец уточняет их отдельно; разбор ответа — в
# bot/services/registry_endpoints.py
REGISTRY_ELK_BASE=https://elk.roszdravnadzor.gov.ru
REGISTRY_MISEARCH_URL=https://roszdravnadzor.gov.ru/services/misearch
REGISTRY_UNREGA_URL=https://roszdravnadzor.gov.ru/services/unrega
REGISTRY_CACHE_DAYS=30

# --- Эксплуатация -------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
DAILY_API_BUDGET_USD=5.0      # мягкий потолок: бот предупреждает, не блокируется
GMAIL_POLL_SECONDS=240        # опрос ответов, ТЗ: раз в 3-5 минут
HTTP_TIMEOUT_CONNECT=10
HTTP_TIMEOUT_READ=60
HTTP_MAX_RETRIES=3
SCRAPE_CONCURRENCY=5          # сколько сайтов поставщиков обходим параллельно

# --- Необязательное -----------------------------------------------------
PROMPT_GUARD_ENABLED=false    # true включает классификатор Meta Prompt-Guard-86M
                              # (тянет torch+transformers, ~550 МБ)
MATHESAR_SECRET_KEY=
