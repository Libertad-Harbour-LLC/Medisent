# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# ID через запятую. Пусто — бот отвечает кому угодно (для приватного заполните).
TELEGRAM_ALLOWED_USER_IDS=
# Случайная строка. Попадает в путь вебхука и в secret_token Telegram.
# Нужна только для serverless-режима (Vercel).
TELEGRAM_WEBHOOK_SECRET=

# ── Провайдер kie.ai: один ключ на чат, картинки и видео ──────────────────
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_CHAT_MODEL=claude-sonnet-5
KIE_IMAGE_MODEL=gpt-image-2-5-flare-text-to-image
KIE_VIDEO_MODEL=kling-3.0/video

# ── Колбэки: куда провайдер пришлёт готовый результат ─────────────────────
# На Vercel PUBLIC_URL подставляется сам из домена проекта, оставьте пустым.
PUBLIC_URL=
# Случайная строка, становится частью секретного пути колбэка. Обязательна.
CALLBACK_SECRET=

# ── Хранилище ─────────────────────────────────────────────────────────────
# Постоянный процесс: файл SQLite.
DATABASE_PATH=data/tasks.sqlite3
# Serverless: Upstash Redis через REST. На Vercel эти две переменные
# подставляет сама интеграция после подключения в разделе Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Прочее ────────────────────────────────────────────────────────────────
PORT=8080
WEB_HOST=0.0.0.0
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
MAX_REPLY_TOKENS=4096
USER_RATE_LIMIT_PER_MINUTE=6
