# ── Обязательные ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
KIE_API_KEY=

# ── Очень желательные ─────────────────────────────────────────────────────
# Свой Telegram ID (через запятую, если несколько). Пусто — бот отвечает
# кому угодно и тратит ваши кредиты провайдера.
TELEGRAM_ALLOWED_USER_IDS=

# ── Необязательные ────────────────────────────────────────────────────────
# Публичный адрес бота. На Vercel подставляется сам из домена проекта,
# для своего сервера укажите вручную. Без него /img и /video работать не будут:
# провайдеру некуда присылать готовый файл.
PUBLIC_URL=

KIE_BASE_URL=https://api.kie.ai
KIE_CHAT_MODEL=claude-sonnet-5
KIE_IMAGE_MODEL=gpt-image-2-5-flare-text-to-image
KIE_VIDEO_MODEL=kling-3.0/video

DATABASE_PATH=data/tasks.sqlite3
PORT=8080
WEB_HOST=0.0.0.0
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
MAX_REPLY_TOKENS=4096
USER_RATE_LIMIT_PER_MINUTE=6

# Секреты в адресах вебхука и колбэка не задаются: они считаются из
# TELEGRAM_BOT_TOKEN. Сменили токен — перерегистрируйте вебхук.
