# Telegram
TELEGRAM_BOT_TOKEN=
# ID через запятую. Пусто — бот отвечает кому угодно (для приватного бота заполните).
TELEGRAM_ALLOWED_USER_IDS=

# Провайдер kie.ai — один ключ на чат, картинки и видео
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_CHAT_MODEL=claude-sonnet-5
KIE_IMAGE_MODEL=gpt-image-2-5-flare-text-to-image
KIE_VIDEO_MODEL=kling-3.0/video

# Публичный адрес сервиса — на него провайдер пришлёт готовый результат.
# Без него картинки и видео будут создаваться, но в чат не придут.
PUBLIC_URL=
# Любая длинная случайная строка: она становится частью секретного пути колбэка.
CALLBACK_SECRET=

# Инфраструктура
PORT=8080
WEB_HOST=0.0.0.0
DATABASE_PATH=data/tasks.sqlite3
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
MAX_REPLY_TOKENS=4096
USER_RATE_LIMIT_PER_MINUTE=6
